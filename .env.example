# Base URL of the RAG backend. No trailing slash.
#
# Set this to whatever PORT the backend's own .env uses — this project's
# backend currently runs on 5050, which is what .env is set to.
#
# On macOS, avoid port 5000: the AirPlay Receiver listens there and answers
# every request with an empty 403, so requests never reach Express. Either turn
# it off in System Settings > General > AirDrop & Handoff, or run the backend on
# another port and match it here.
VITE_API_BASE_URL=http://localhost:5050
